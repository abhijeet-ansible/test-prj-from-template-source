    <configuration-properties doc:name="Configuration properties" doc:id="993e5d47-5b98-4c59-b197-7d12ad3ac0b1" file="config/common.yaml" />
    <secure-properties:config name="Secureproperties" doc:name="Secure Properties Config" doc:id="37061aa7-62a1-49b5-aac8-84a248b503d9" file="config/test-prj-from-template-source-${mule.env}-config.yaml" key="${secure.key}" />
    <!-- 2. TLS Context -->
    <tls:context name="Listener_TLS_Context" doc:name="TLS Context" doc:id="7c992b6a-504b-44c7-ad28-1819d6039ab6">
        <tls:key-store type="jks" path="${environment.listener.jksPath}" keyPassword="${secure::environment.listener.jksKeyPwd}" password="${secure::environment.listener.jksPwd}" />
